{
  "manifest_version": 3,
  "name": "GC VAULT Quick Save",
  "default_locale": "en",
  "version": "1.0.0",
  "description": "__MSG_extDesc__",
  "minimum_chrome_version": "110",
  "homepage_url": "https://vault.xuts.net/about.html#extension",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "__MSG_actionTitle__",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" } },
  "commands": {
    "save-to-vault": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "__MSG_cmdDesc__"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://vault.xuts.net/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
